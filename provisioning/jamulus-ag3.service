[Unit]
Description=Jamulus Any Genre 3 server
After=network.target
StartLimitIntervalSec=0

[Service]
User=jamulus
Group=nogroup
NoNewPrivileges=true
ProtectSystem=true
Nice=-20
IOSchedulingClass=realtime
IOSchedulingPriority=0
ExecStart=/bin/sh -c 'exec /usr/bin/jamulus-jamfan --nogui --server --port 22224 --directoryserver anygenre3.jamulus.io:22624 --serverinfo "Name;;CC" -u 8 --jsonrpcport 9999 --jsonrpcsecretfile /secret.txt --jsonrpcbindip 0.0.0.0'
Restart=on-failure
RestartSec=30
SyslogIdentifier=jamulus

[Install]
WantedBy=multi-user.target
