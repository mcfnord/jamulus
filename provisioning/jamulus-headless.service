[Unit]
Description=Jamulus headless server
After=network.target
StartLimitIntervalSec=0

[Service]
User=jamulus
Group=nogroup
NoNewPrivileges=true
ProtectSystem=true
Nice=-20
IOSchedulingClass=realtime
IOSchedulingPriority=0
ExecStart=/bin/sh -c 'exec /usr/bin/jamulus-jamfan --nogui --server --port 22224 --directoryserver anygenre1.jamulus.io:22124 --serverinfo "Name;;CC" -u 8 --jsonrpcport 9999 --jsonrpcsecretfile /secret.txt --jsonrpcbindip 0.0.0.0 -w "<br>See https://jamulus.live for a live view of Jamulus public servers.<br>Type /stream to stream or record to MP3."'
Restart=on-failure
RestartSec=30
SyslogIdentifier=jamulus

[Install]
WantedBy=multi-user.target
