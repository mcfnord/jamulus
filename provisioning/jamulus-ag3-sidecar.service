[Unit]
Description=Jamulus Any Genre 3 sidecar server
After=network.target
StartLimitIntervalSec=0

[Service]
User=jamulus
Group=nogroup
NoNewPrivileges=true
ProtectSystem=true
Nice=-20
IOSchedulingClass=realtime
IOSchedulingPriority=0
ExecStart=/bin/sh -c 'exec /usr/bin/jamulus-jamfan --nogui --server --port 22225 --directoryserver anygenre3.jamulus.io:22624 --serverinfo "Name;;CC" -u 6 --jsonrpcport 9998 --jsonrpcsecretfile /secret.txt --jsonrpcbindip 0.0.0.0'
Restart=on-failure
RestartSec=30
SyslogIdentifier=jamulus-ag3

[Install]
WantedBy=multi-user.target
